#!/bin/bash
# preinstall — Stop the existing hop daemon before upgrading.
# Runs as root during .pkg installation.

set -e

LABEL="com.hop.agent"

# Detect the console (GUI) user — may be empty during headless installs.
CONSOLE_USER=$(stat -f "%Su" /dev/console 2>/dev/null || true)

if [ -z "$CONSOLE_USER" ] || [ "$CONSOLE_USER" = "root" ] || [ "$CONSOLE_USER" = "loginwindow" ]; then
    echo "No GUI user logged in — skipping daemon stop (will start at next login)."
    exit 0
fi

CONSOLE_UID=$(id -u "$CONSOLE_USER" 2>/dev/null || true)
if [ -z "$CONSOLE_UID" ]; then
    echo "Could not resolve UID for $CONSOLE_USER — skipping daemon stop."
    exit 0
fi

echo "Stopping hop daemon for $CONSOLE_USER (uid $CONSOLE_UID)..."
launchctl bootout "gui/$CONSOLE_UID/$LABEL" 2>/dev/null || true

exit 0
