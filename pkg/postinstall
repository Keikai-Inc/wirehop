#!/bin/bash
# postinstall — Set permissions, migrate config, and start the hop daemon.
# Runs as root during .pkg installation.

set -e

LABEL="com.hop.daemon"
PLIST="/Library/LaunchDaemons/com.hop.daemon.plist"
BINARY="/usr/local/bin/hop"
SYSTEM_CONFIG="/Library/Application Support/hop"

# Ensure /usr/local/bin exists
mkdir -p /usr/local/bin

# Set correct ownership and permissions
chown root:wheel "$BINARY"
chmod 755 "$BINARY"
chown root:wheel "$PLIST"
chmod 644 "$PLIST"

# Create system-level config directory
mkdir -p "$SYSTEM_CONFIG"
chmod 700 "$SYSTEM_CONFIG"

# Migrate config from the installing user's per-user directory if the
# system-level directory has no identity yet.
CONSOLE_USER=$(stat -f "%Su" /dev/console 2>/dev/null || true)
if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ] && [ "$CONSOLE_USER" != "loginwindow" ]; then
    USER_HOME=$(eval echo "~$CONSOLE_USER")
    USER_CONFIG="$USER_HOME/Library/Application Support/hop"

    if [ ! -f "$SYSTEM_CONFIG/identity.json" ] && [ -f "$USER_CONFIG/identity.json" ]; then
        echo "Migrating hop config from $USER_CONFIG to $SYSTEM_CONFIG..."
        cp -n "$USER_CONFIG/identity.json" "$SYSTEM_CONFIG/identity.json" 2>/dev/null || true
        cp -n "$USER_CONFIG/peers.json" "$SYSTEM_CONFIG/peers.json" 2>/dev/null || true
        cp -n "$USER_CONFIG/pending_invites.json" "$SYSTEM_CONFIG/pending_invites.json" 2>/dev/null || true
        chmod 600 "$SYSTEM_CONFIG"/*.json 2>/dev/null || true
        echo "Config migrated. User copy left in place."
    fi
fi

echo "Starting hop daemon..."

# Load the daemon into the system domain
if launchctl bootstrap system "$PLIST" 2>/dev/null; then
    echo "Hop daemon loaded."
else
    echo "Already loaded — restarting..."
    launchctl kickstart -k "system/$LABEL" 2>/dev/null || true
fi

exit 0
